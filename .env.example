DATABASE_URL=postgres://audit:audit@localhost:5435/audit?sslmode=disable

KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=user-actions

HTTP_PORT=8080
# Сколько API ждёт подтверждения Kafka после сохранения события.
AUDIT_PUBLISH_TIMEOUT=30s

KAFKA_GROUP=analytics-group

KAFKA_COMMIT_INTERVAL=5s
# Максимальный размер пакета чтения Kafka в байтах (10 МиБ).
KAFKA_READ_MAX_BYTES=10485760

ANALYTICS_INTERVAL=5m

ANALYTICS_WINDOW=1h
